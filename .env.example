# Copy to .env.local and fill in real values. .env.local is gitignored.

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres connection string. Local dev example:
#   postgresql://postgres:postgres@localhost:5432/aiden_dev
DATABASE_URL=

# 32+ random bytes; generate with: openssl rand -base64 32
AUTH_SECRET=

# Production only: Auth.js v5 rejects requests in production unless the host is
# trusted ("UntrustedHost"). Set the public URL, or trust the proxy's Host header.
# AUTH_URL=https://deskline.example.com
# AUTH_TRUST_HOST=true

# Local dev only: password for every DeskLine demo account `npm run db:seed`
# creates (12+ chars). The seed skips demo accounts when NODE_ENV=production.
SEED_PASSWORD=

# ─── App ─────────────────────────────────────────────────────────────────────

# Brand name. Leave unset to use aiden.config.ts app.name ("DeskLine");
# setting it here overrides the config everywhere in the UI.
# NEXT_PUBLIC_APP_NAME="DeskLine"
# debug | info | warn | error
LOG_LEVEL=info
# Alert (log + audit event ai.spend_alert) when one user's AI spend in the
# last hour crosses this many USD. Detection only; 0 disables. Default 1.
# AI_SPEND_ALERT_USD_PER_HOUR=1

# ─── Auth providers ──────────────────────────────────────────────────────────
# Uncomment only the providers you've enabled in aiden.config.ts.

# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# ─── AI providers ────────────────────────────────────────────────────────────
# Uncomment only the providers you've enabled in aiden.config.ts.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# COHERE_API_KEY=
