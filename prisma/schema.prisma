// ─── prisma\fragments\org.prisma ───
// DeskLine — tenant. Every Membership, Ticket and AIUsage row belongs to one Org.

model Org {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  memberships Membership[]
  tickets     Ticket[]
  aiUsage     AIUsage[]

  @@map("orgs")
}

// ─── prisma\fragments\ratelimit.prisma ───
// Shared sliding-window store for withRateLimit (src/lib/rate-limit-store.ts),
// so sign-in and registration limits hold across instances and restarts.
// `key` is a SHA-256 hash: no emails or IP addresses are stored.

model RateLimitHit {
  id  BigInt   @id @default(autoincrement())
  key String
  at  DateTime @default(now())

  @@index([key, at])
  @@index([at])
  @@map("rate_limit_hits")
}

// ─── prisma\fragments\ticket.prisma ───
// DeskLine — support ticket. `status`: open | pending | closed.
// priority/category/sentiment are set by AI triage (src/lib/triage.ts).

model Ticket {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  ownerId   String   @map("owner_id")
  subject   String
  body      String
  status    String   @default("open")
  priority  String?
  category  String?
  sentiment String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org   Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Restrict: tickets belong to the org, so deleting a user must never take
  // tickets with it. Account deletion hands them to an org owner first
  // (src/lib/account-deletion.ts).
  owner User @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([ownerId])
  @@index([orgId, status])
  @@map("tickets")
}

