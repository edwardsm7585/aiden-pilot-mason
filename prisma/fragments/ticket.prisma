// DeskLine — support ticket. `status`: open | pending | closed.
// priority/category/sentiment are set by AI triage (src/lib/triage.ts).

model Ticket {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  ownerId   String   @map("owner_id")
  subject   String
  body      String
  status    String   @default("open")
  priority  String?
  category  String?
  sentiment String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org   Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Restrict: tickets belong to the org, so deleting a user must never take
  // tickets with it. Account deletion hands them to an org owner first
  // (src/lib/account-deletion.ts).
  owner User @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([ownerId])
  @@index([orgId, status])
  @@map("tickets")
}
